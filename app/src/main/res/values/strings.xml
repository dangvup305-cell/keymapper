    <!-- 权限引导（P0-8） -->
    <string name="title_settings">设置 / 权限引导</string>
    <string name="perm_accessibility_title">无障碍服务</string>
    <string name="perm_accessibility_desc">用于后台监听全局键盘按键并向屏幕注入触摸事件。这是本工具的核心能力，未开启则按键无法触发点击。</string>
    <string name="perm_overlay_title">悬浮窗权限</string>
    <string name="perm_overlay_desc">用于在其他应用之上显示悬浮球、操作面板与映射标记。未开启则无法跨应用使用。</string>
    <string name="perm_notification_title">通知权限</string>
    <string name="perm_notification_desc">前台保活服务需要显示一条常驻通知，避免系统在后台回收监听服务（Android 13 及以上需要授权）。</string>
    <string name="setting_low_battery_title">低电量降频</string>
    <string name="setting_low_battery_desc">电量低于 20%% 时自动降低悬浮窗刷新率与动画频率，不影响按键触发精度。</string>
    <string name="setting_auto_switch_title">按前台应用自动切换配置</string>
    <string name="setting_auto_switch_desc">检测到前台应用包名与某个配置的 appPackage 一致时自动加载该配置，关闭则完全由您手动切换。</string>
    <string name="setting_about_title">关于</string>
    <string name="setting_about_desc">KeyMapper v1.0 — 全部映射数据以 JSON 形式保存在应用私有目录，可随时导出迁移。</string>

