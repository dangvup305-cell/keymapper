    <string name="app_name">KeyMapper 按键映射</string>

    <!-- 无障碍服务 -->
    <string name="accessibility_service_label">KeyMapper 按键映射服务</string>
    <string name="accessibility_service_summary">监听物理键盘并在屏幕对应坐标模拟触摸</string>
    <string name="accessibility_service_description">开启后，KeyMapper 可以监听物理键盘按键，并把按键映射为屏幕坐标上的点击、长按、滑动等触摸操作。本服务不会读取或上传您的任何输入内容，全部数据仅保存在本机。</string>

